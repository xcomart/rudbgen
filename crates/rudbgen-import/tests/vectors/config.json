            "icon": "stock:postgresql.png",
            "props": {}
        },
        {
            "stockItem": true,
            "name": "Oracle",
            "driverClass": "oracle.jdbc.OracleDriver",
            "urlTemplate": "jdbc:oracle:thin:@//<databaseHost>:1521/<database>",
            "icon": "stock:oracle.png"
        },
        {
            "stockItem": false,
            "name": "Our Warehouse",
            "driverClass": "com.example.warehouse.Driver",
            "urlTemplate": "jdbc:example://<databaseHost>:7777/<warehouse>",
            "jdbcJar": "drivers/warehouse-1.0.jar",
            "mavenArtifact": "com.example:warehouse-jdbc:1.0",
            "icon": "fa:database",
            "useColumns": true,
            "columnsSql": "select * from wh_columns where t = '${table}'",
            "props": { "compress": "true" }
        },
        {
            "stockItem": true,
            "name": "Gone Product",
            "driverClass": "com.gone.Driver",
            "urlTemplate": "jdbc:gone:<databaseHost>"
        }
    ],
