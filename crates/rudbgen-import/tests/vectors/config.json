    "drivers": [
        {
            "stockItem": true,
            "name": "H2 Embedded",
            "driverClass": "org.h2.Driver",
            "urlTemplate": "jdbc:h2:<database file>",
            "mavenArtifact": "com.h2database:h2:2.4.240",
            "jdbcJar": "drivers/h2-2.4.240.jar",
            "noAuth": true,
            "icon": "stock:h2.png",
            "useTables": true,
            "tablesSql": "select 1 from information_schema.tables",
            "props": { "MODE": "Oracle" }
        },
        {
            "stockItem": true,
            "name": "PostgreSQL",
            "driverClass": "org.postgresql.Driver",
