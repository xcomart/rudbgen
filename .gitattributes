# Store every text file with LF in the repository and check it out with LF on
# every platform. Rust, cargo, rustfmt and clippy are all indifferent to line
# endings, so there is nothing to gain from native CRLF on Windows and plenty to
# lose: without this, a Windows checkout rewrites every file and the next commit
# from macOS or Linux shows the whole tree as modified.
* text=auto eol=lf

# Files git must never rewrite or try to diff as text.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.icns binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.exe binary
*.dll binary
*.pdb binary
*.so binary
*.dylib binary

# The template engine's golden files carry CRLF on purpose: the line-end
# detection they test is the first newline of the template. Never normalise.
crates/rudbgen-template/tests/golden/** -text

# The built-in templates are copied into the user's configuration directory
# byte for byte, CRLF and all: the engine detects a template's line ending from
# its first newline, and normalising these would silently change the line
# endings of every file generated from them.
templates/** -text
